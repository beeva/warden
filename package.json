{
  "name": "warden",
  "version": "0.1.0",
  "private": true,
  "description": "Static analysis for smart contracts that models the exploit classes that actually recur on-chain, runs on every commit, and gates CI on criticals.",
  "keywords": [
    "solidity",
    "static-analysis",
    "security",
    "smart-contracts",
    "cli"
  ],
  "license": "MIT",
  "bin": {
    "warden": "./bin/warden.js"
  },
  "scripts": {
    "dev": "next dev -p 3522",
    "build": "next build",
    "start": "next start -p 3522",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "evals": "tsx scripts/evals.ts",
    "scan": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.19.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.38.0",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
