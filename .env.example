# Postgres connection string. `npm run db:up` starts a local instance via
# docker-compose; this repo's own dev/test setup instead uses a native
# `initdb`-created data directory on the same port, since Docker isn't
# available in every environment this was built in.
DATABASE_URL=postgres://warden:warden@localhost:5438/warden
# (this repo's own .env uses a locally-generated password, not the literal "warden" above)

# HS256 signing secret for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3522
